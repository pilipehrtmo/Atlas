# Copy to .env and fill in. Never commit .env. All keys are read by the server only;
# nothing here is sent to the browser.

# Product name shown in the UI.
ATLAS_PRODUCT_NAME=Atlas

# demo = synthetic data for fictional companies, no network calls.
# live = real providers below. Missing keys make that capability "unavailable"; nothing falls back to demo data.
ATLAS_DATA_MODE=live

PORT=8787
HOST=127.0.0.1
ATLAS_DB_PATH=./data/atlas.db

# Optional. When set, every /api request must send "Authorization: Bearer <token>".
# Set it before exposing the server beyond localhost. The UI shows a sign-in screen that asks for it.
ATLAS_ACCESS_TOKEN=

# SEC EDGAR (free, keyless). SEC requires a descriptive User-Agent with contact details.
SEC_USER_AGENT="Your Name or Company your.email@example.com"

# FRED macro data. Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Tiingo end-of-day prices and search for all US stocks and ETFs (recommended). Free key: https://www.tiingo.com
TIINGO_API_KEY=

# Alpha Vantage quotes and daily history, used only when TIINGO_API_KEY is empty. Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Claude API for the RESEARCH assistant. Without it, RESEARCH returns the evidence pack only.
ANTHROPIC_API_KEY=
ATLAS_AI_MODEL=claude-opus-5-5

# ECB reference rates (keyless). Override only if you self-host Frankfurter.
FRANKFURTER_BASE_URL=https://api.frankfurter.app
